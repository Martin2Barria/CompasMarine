VITE_APP_API_BASE_URL=/api

SERVER_PORT=8787
SERVER_HOST=127.0.0.1
CONTROLDOC_BASE_URL=https://compliance.controldoc.legal
CONTROLDOC_CUSTOMER_ID=
CONTROLDOC_DEFAULT_ENTITY_TYPE_ID=467

# para el primer deployment, configura un default server-side ControlDoc user.
CONTROLDOC_USER_EMAIL=
CONTROLDOC_USER_TOKEN=

# para credenciales por usuario, prefiere un JSON map y selecciona el user por session/cookie.
CONTROLDOC_DEFAULT_USER_ID=demo
CONTROLDOC_USER_CREDENTIALS_JSON={"demo":{"email":"","token":"","customerId":"","entityTypeId":"467"}}

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
